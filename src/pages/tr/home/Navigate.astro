---
import NavCard from "~/components/NavCard.astro"
import DevelopSvg from "~/assets/svgs/home/home-develop.svg?raw"
import TechnologySvg from "~/assets/svgs/home/home-technology.svg?raw"
import SdkSvg from "~/assets/svgs/home/home-sdk.svg?raw"
import SectionHeader from "~/components/SectionHeader/index.astro"

const navList = [
  {
    icon: DevelopSvg,
    name: "Geliştiriciler",
    content: "Scroll'un geliştirici dokümanlarını inceleyin.",
    link: "/tr/developers",
  },
  {
    icon: TechnologySvg,
    name: "Teknoloji",
    content: "Scroll'un zkEVM mimarisine genel bakış.",
    link: "/tr/technology",
  },
  {
    icon: SdkSvg,
    name: "SDK",
    content: "Bir zincir ayağa kaldırın ve kendi ekosisteminize sahip olun.",
    link: "/tr/sdk",
  },
]
---

<div class="navigate">
  <SectionHeader title="Dokümantasyon'u gezin" content="Scroll'da geliştirmeye bugün başlayın." />
  <div class="navs">
    {navList.map(({ icon, name, content, link }) => <NavCard icon={icon} name={name} content={content} link={link} />)}
  </div>
</div>

<style>
  .navigate {
    margin-top: 40px;
  }

  .navs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  @media screen and (max-width: 50em) {
    .navigate {
      margin-top: 24px;
    }
    .navs {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 32px;
    }
  }
</style>
