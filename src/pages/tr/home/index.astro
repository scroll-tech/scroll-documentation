---
import { changeLanguage } from "i18next"
import HomeLayout from "../../../layouts/HomeLayout.astro"
import Search from "../../../components/HomeSearch"
import Navigate from "./Navigate.astro"
import ConnectUs from "./ConnectUs.astro"

changeLanguage("tr")
---

<HomeLayout>
  <div class="header">
    <div class="inner">
      <p class="header-title">Scroll Dokümantasyonu'na <br /> Hoş Geldiniz!</p>
      <Search client:visible />
    </div>
  </div>
  <div class="content">
    <div class="inner">
      <Navigate />
      <ConnectUs />
    </div>
  </div>
</HomeLayout>

<style>
  /* the landing page's hero (scroll.html): the display serif centred on the brand ground, with
     a faint violet behind the search where the landing page has its dither */
  .header {
    position: relative;
    padding: 96px 60px 88px;
    text-align: center;
    background: radial-gradient(ellipse 46% 36% at 50% 62%, rgba(109, 69, 232, 0.11), transparent);
  }
  .inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .header .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }
  .header-title {
    margin: 0;
    max-width: 900px;
    font-family: var(--sc-serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
    -webkit-text-stroke: 0.42px currentColor;
    color: var(--sc-ink);
  }

  .content {
    padding: 40px 60px 140px;
  }

  @media screen and (max-width: 50em) {
    .header {
      padding: 64px 20px 64px;
    }
    .header .inner {
      gap: 28px;
    }
    .content {
      padding: 32px 20px 96px;
    }
  }
</style>
