---
import SectionHeader from "~/components/SectionHeader/index.astro"
import LinkArrowSvg from "~/assets/svgs/home/home-link-arrow.svg?raw"
import DiscordSvg from "~/assets/svgs/home/Discord.svg?raw"
import ForumSvg from "~/assets/svgs/home/Forum.svg?raw"
import ContributeSvg from "~/assets/svgs/home/Contribute.svg?raw"
import NoteSvg from "~/assets/svgs/home/Note.svg?raw"

const mediaList = [
  {
    icon: DiscordSvg,
    name: "加入我们的 Discord",
    content: "与其他 Scroll 开发者和用户建立联系",
    link: "https://discord.gg/scroll",
  },
  {
    icon: NoteSvg,
    name: "获取支持",
    content: "如果您需要更多的支持，请直接联系我们。",
    link: "https://tally.so/r/waxLBW",
  },
  {
    icon: ForumSvg,
    name: "社区论坛",
    content: "讨论并提出对 Scroll 核心协议的更改。",
    link: "http://community.scroll.io/",
  },
  {
    icon: ContributeSvg,
    name: "为Scroll贡献",
    content: "与其他开发者一起构建。",
    link: "https://github.com/scroll-tech/contribute-to-scroll",
  },
]
---

<div class="connect-us">
  <SectionHeader title="联系我们" content="随时了解来自 Scroll 社区的最新新闻和发展信息。" />
  <div class="medias">
    {
      mediaList.map(({ icon, name, content, link }) => (
        <a class="media-item" href={link} target="_blank">
          <div class="media-item-header">
            <span class="media-item-link">
              <Fragment set:html={LinkArrowSvg} />
            </span>
            <span class="media-item-icon">
              <Fragment set:html={icon} />
            </span>
          </div>

          <span class="media-item-title">{name}</span>
          <span class="media-item-content">{content}</span>
        </a>
      ))
    }
  </div>
</div>

<style>
  .connect-us {
    margin-top: 120px;
  }

  .medias {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  /* the landing page's cards: a white sheet with a hairline that lifts on hover */
  .media-item {
    min-height: 260px;
    padding: 28px;
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--sc-surface);
    border: 1px solid var(--sc-line-2);
    color: var(--sc-ink);
    transition: transform 0.85s var(--sc-ease-soft), box-shadow 0.85s var(--sc-ease-soft),
      border-color 0.4s var(--sc-ease);
  }

  .media-item:hover {
    color: var(--sc-ink);
    transform: translateY(-6px);
    border-color: var(--sc-line);
    box-shadow: var(--sc-shadow-lift);
  }

  .media-item-header {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
  }

  .media-item-link {
    width: 18px;
    height: 18px;
    align-self: flex-end;
    color: var(--sc-ink-3);
    transition: color 0.25s var(--sc-ease);
  }

  .media-item:hover .media-item-link {
    color: var(--sc-violet);
  }

  .media-item-link :global(svg) {
    width: 100%;
    height: 100%;
  }

  .media-item-icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    color: var(--sc-ink);
  }
  .media-item-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .media-item-title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 24px;
    line-height: 1.3;
    margin-bottom: 8px;
    color: var(--sc-ink);
  }
  .media-item-content {
    font-size: 15px;
    line-height: 1.55;
    color: var(--sc-ink-2);
  }

  @media screen and (max-width: 50em) {
    .connect-us {
      margin-top: 88px;
    }
    .medias {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 32px;
    }
    .media-item {
      min-height: 0;
      padding: 22px;
    }
    .media-item-header {
      flex-direction: row-reverse;
      flex: unset;
    }
    .media-item-link {
      width: 14px;
      height: 14px;
      align-self: flex-start;
    }
    .media-item-icon {
      width: 26px;
      height: 26px;
    }
    .media-item-title {
      margin-top: 12px;
    }
  }
</style>
