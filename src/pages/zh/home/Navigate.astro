---
import NavCard from "~/components/NavCard.astro"
import DevelopSvg from "~/assets/svgs/home/home-develop.svg?raw"
import TechnologySvg from "~/assets/svgs/home/home-technology.svg?raw"
import SdkSvg from "~/assets/svgs/home/home-sdk.svg?raw"
import SectionHeader from "~/components/SectionHeader/index.astro"

const navList = [
  {
    icon: DevelopSvg,
    name: "开发者",
    content: "深入了解 Scroll 的开发者文档",
    link: "/zh/developers",
  },
  {
    icon: TechnologySvg,
    name: "技术",
    content: "Scroll 的 zkEVM 架构概述",
    link: "/zh/technology",
  },
  {
    icon: SdkSvg,
    name: "SDK",
    content: "部署链并拥有您的区块空间。",
    link: "/zh/sdk",
  },
]
---

<div class="navigate">
  <SectionHeader title="文档导航" content="今天开始在 Scroll 上进行开发" />
  <div class="navs">
    {navList.map(({ icon, name, content, link }) => <NavCard icon={icon} name={name} content={content} link={link} />)}
  </div>
</div>

<style>
  .navigate {
    margin-top: 40px;
  }

  .navs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  @media screen and (max-width: 50em) {
    .navigate {
      margin-top: 24px;
    }
    .navs {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-top: 32px;
    }
  }
</style>
