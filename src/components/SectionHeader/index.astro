---
interface Props {
  title: string
  content: string
}
const { title, content } = Astro.props as Props
---

<>
  <h1 class="title">{title}</h1>
  <p class="content">{content}</p>
</>

<style>
  /* the landing page's section title (scroll.html .section-title) and its lede */
  p {
    margin-bottom: 0;
  }
  .title {
    font-family: var(--sc-serif);
    font-weight: 400;
    font-size: clamp(2.4rem, 4.6vw, 3.5rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    -webkit-text-stroke: 0.42px currentColor;
    color: var(--sc-ink);
    margin-bottom: 16px;
  }
  .content {
    max-width: 620px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--sc-ink-3);
  }

  @media screen and (max-width: 600px) {
    .content {
      font-size: 16px;
    }
  }
</style>
