---
import i18next, { t } from "i18next"
import LinkSvg from "~/assets/svgs/home/home-link.svg?raw"
export type Props = {
  icon: string
  name: string
  content: string
  link: string
}
const { icon, name, content, link } = Astro.props as Props

/**
 * This component adds the classNames required by the scripts/click-to-zoom.ts script.
 */
---

<div class="navs-item">
  <span class="navs-item-icon">
    <Fragment set:html={icon} />
  </span>
  <span class="navs-item-title">{name}</span>
  <span class="navs-item-content">{content}</span>
  <a class="navs-item-link" href={link}>
    {t("ui.readMore")}
    <span class="link-icon">
      <Fragment set:html={LinkSvg} />
    </span>
  </a>
</div>

<style>
  /* the landing page's card: a white sheet with a hairline that lifts on hover */
  .navs-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 28px;
    border-radius: 20px;
    background: var(--sc-surface);
    border: 1px solid var(--sc-line-2);
    transition: transform 0.85s var(--sc-ease-soft), box-shadow 0.85s var(--sc-ease-soft),
      border-color 0.4s var(--sc-ease);
  }

  .navs-item:hover {
    transform: translateY(-6px);
    border-color: var(--sc-line);
    box-shadow: var(--sc-shadow-lift);
  }

  .navs-item-icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    margin-bottom: 20px;
    color: var(--sc-ink);
  }

  .navs-item-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .navs-item-title {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--sc-ink);
  }
  .navs-item-content {
    flex: 1;
    font-size: 15px;
    line-height: 1.55;
    color: var(--sc-ink-2);
    margin-bottom: 16px;
  }

  /* the landing page's pill button */
  .navs-item-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--sc-line);
    background: var(--sc-surface);
    color: var(--sc-ink);
    font-size: 14px;
    font-weight: 500;
    transition: color 0.3s var(--sc-ease), background-color 0.3s var(--sc-ease), border-color 0.3s var(--sc-ease);
  }
  .navs-item-link:hover,
  .navs-item-link:focus {
    color: var(--sc-page);
    background: var(--sc-ink);
    border-color: var(--sc-ink);
  }

  .link-icon {
    display: inline-flex;
    width: 9px;
    height: 9px;
    color: inherit;
  }

  .link-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 50em) {
    .navs-item {
      padding: 22px;
    }
    .navs-item-icon {
      width: 26px;
      height: 26px;
      margin-bottom: 8px;
    }
    .navs-item-content {
      margin-bottom: 8px;
    }
  }
</style>
